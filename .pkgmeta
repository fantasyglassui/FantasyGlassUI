# How the CurseForge packager builds the release zip from this repository (see .github/workflows/release.yml).
# The zip holds the add-on's three folders side by side, as players install them.
package-as: FantasyGlassUI

move-folders:
  FantasyGlassUI/FantasyGlassUI: FantasyGlassUI
  FantasyGlassUI/FantasyGlassUI_Options: FantasyGlassUI_Options
  FantasyGlassUI/FantasyGlassUI_Locales: FantasyGlassUI_Locales

ignore:
  - .github
  - .luacheckrc
  - tests
  - wiki
  - docs
  - specs
  - README.md
  - CHANGELOG.md
  - RELEASE.md
  - LICENSE

manual-changelog:
  filename: RELEASE.md
  markup-type: markdown
