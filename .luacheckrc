-- luacheck settings for Fantasy Glass UI (made by tools/luacheck_globals.py; the lists are the game's
-- names the add-on uses, so a misspelled name in new code is still caught).
std = "lua51"
max_line_length = false
exclude_files = { ".release", "FantasyGlassUI_Locales/Locales.lua", "tests/.cache" }
ignore = {
    "212",                  -- unused arguments (the game passes many; handlers keep their full shape)
    "213",                  -- unused loop variables
    "42.", "43.",           -- a local named like one around it
    "542",                  -- an empty if branch, kept on purpose with a comment saying why
    "211/th", "211/FONT", "211/ADDON", "211/a",   -- the usual locals at the top of a file
}
-- names the add-on sets: its slash command, key binding names, saved settings and the like
